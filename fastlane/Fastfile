# Fastlane: build the iOS app on a GitHub macOS runner and upload to TestFlight.
# No Apple ID password anywhere: everything runs through an App Store Connect API key.
#
# Required env (GitHub secrets):
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_P8 (contents of the .p8), APPLE_TEAM_ID
# The Xcode project is generated on the runner by `npx expo prebuild` before this runs.

require "date"
require "base64"

default_platform(:ios)

APP_ID   = "lv.uzminicenu.app"
APP_NAME = "Uzmini Cenu"
XCODEPROJ = "ios/UzminiCenu.xcodeproj"
WORKSPACE = "ios/UzminiCenu.xcworkspace"
SCHEME    = "UzminiCenu"

platform :ios do
  desc "Build a signed App Store IPA and upload it to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8"),
      is_key_content_base64: false,
      in_house: false,
    )

    setup_ci # temporary keychain on the runner

    # Bundle id + capabilities + App Store Connect app record, straight through the ASC API
    # (fastlane's `produce` needs an Apple ID login; the API key path is these calls).
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)
    bundle = Spaceship::ConnectAPI::BundleId.all(filter: { identifier: APP_ID }).find { |b| b.identifier == APP_ID }
    unless bundle
      UI.message("Registering bundle id #{APP_ID}")
      bundle = Spaceship::ConnectAPI::BundleId.create(name: "Uzmini Cenu", platform: "IOS", identifier: APP_ID)
    end
    existing_caps = bundle.get_capabilities.map(&:capability_type)
    { "PUSH_NOTIFICATIONS" => nil, "ASSOCIATED_DOMAINS" => nil }.each_key do |cap|
      next if existing_caps.include?(cap)
      UI.message("Enabling #{cap}")
      bundle.create_capability(cap)
    end
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    # Apple's API does not allow creating apps; the record is created once by hand in App Store Connect.
    UI.user_error!("No App Store Connect app for #{APP_ID}. Create it in App Store Connect → My Apps → + (bundle id #{APP_ID}).") unless app
    UI.success("App record ready: #{app.name} (#{app.id})")

    # Distribution certificate. Runners are ephemeral, so the private key must be persisted:
    #  - if DIST_CERT_P12 (base64 .p12, no password) is set as a secret → import it;
    #  - else revoke certs created by earlier CI runs today, create one, and export its .p12 to
    #    fastlane/certs/ (kept as a workflow artifact → store as the DIST_CERT_P12 secret).
    if ENV["DIST_CERT_P12"].to_s.strip.empty?
      today_plus_year = (Date.today >> 12)
      Spaceship::ConnectAPI::Certificate.all(filter: { certificateType: "DISTRIBUTION" }).each do |c|
        exp = Date.parse(c.expiration_date) rescue nil
        next unless exp && (exp - today_plus_year).abs <= 1  # created today (Apple: +365 d)
        UI.important("Revoking throwaway CI certificate #{c.id} (expires #{exp})")
        c.delete!
      end
      cert(api_key: api_key, team_id: ENV.fetch("APPLE_TEAM_ID"), generate_apple_certs: true, force: true,
           output_path: "fastlane/certs",
           keychain_path: File.expand_path("~/Library/Keychains/fastlane_tmp_keychain-db"), keychain_password: "")
      UI.important("Exported fastlane/certs/*.p12 — base64 it into the DIST_CERT_P12 secret so future runs reuse it")
    else
      p12 = File.expand_path("dist.p12")
      File.binwrite(p12, Base64.decode64(ENV["DIST_CERT_P12"]))
      import_certificate(certificate_path: p12, certificate_password: "",
                         keychain_path: File.expand_path("~/Library/Keychains/fastlane_tmp_keychain-db"), keychain_password: "")
    end

    # App Store provisioning profile for the bundle id.
    sigh(api_key: api_key, app_identifier: APP_ID, team_id: ENV.fetch("APPLE_TEAM_ID"), force: true, skip_certificate_verification: true)

    update_code_signing_settings(
      path: XCODEPROJ,
      use_automatic_signing: false,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      code_sign_identity: "Apple Distribution",
      profile_name: lane_context[SharedValues::SIGH_NAME],
      bundle_identifier: APP_ID,
      targets: [SCHEME],
    )

    # Build number = GitHub run number so every upload is unique.
    increment_build_number(xcodeproj: XCODEPROJ, build_number: ENV.fetch("BUILD_NUMBER", Time.now.strftime("%Y%m%d%H%M")))

    gym(
      workspace: WORKSPACE,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      clean: true,
      output_directory: "build",
      output_name: "UzminiCenu.ipa",
      xcargs: "-allowProvisioningUpdates",
      export_options: { provisioningProfiles: { APP_ID => lane_context[SharedValues::SIGH_NAME] } },
    )

    pilot(
      api_key: api_key,
      ipa: "build/UzminiCenu.ipa",
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      changelog: "Automated build #{ENV['BUILD_NUMBER']}",
    )
  end
end
