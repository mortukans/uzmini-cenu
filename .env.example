# Copy to .env (git-ignored). All EXPO_PUBLIC_* values are embedded in the app bundle.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Optional integrations. Leave empty to run without them.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ID=
EXPO_PUBLIC_ADMOB_REWARDED_ID=
EXPO_PUBLIC_ADS_ENABLED=false
EXPO_PUBLIC_UNIVERSAL_LINK_HOST=uzminicenu.lv

# Sign in with Google (optional; button hidden when empty). Apple needs no env: it is
# enabled by ios.usesAppleSignIn in app.config.ts + the Supabase Apple provider.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# reversed iOS client id, e.g. com.googleusercontent.apps.1234567890-abc
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
